# Copie este arquivo para .env e preencha os valores (o .env NUNCA vai para o Git)

# Porta da API
PORT=3000

# String de conexao do Supabase (Connect -> Session pooler -> URI)
# Troque [YOUR-PASSWORD] pela senha do seu banco
DATABASE_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase exige SSL (deixe true)
DB_SSL=true

# Custo do hash das senhas (bcrypt)
BCRYPT_ROUNDS=10

# Segredo para assinar os tokens JWT (invente uma frase longa)
JWT_SECRET=troque-por-um-segredo-bem-grande
JWT_EXPIRA=8h
